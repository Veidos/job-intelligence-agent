# Copiar a .env y rellenar con valores reales — NUNCA commitear .env
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
DB_PATH=data/jobs.db
LOG_PATH=logs/pipeline.log
PERFIL_PATH=PERFIL.md
OLLAMA_BASE_URL=http://localhost:11434

# ── Scraper (ADR-023) ──
# scrapling = transporte con warming + capa bronze + escalada stealth
# curl_cffi = rollback instantáneo al scraper legacy
SCRAPER_BACKEND=scrapling
# Escalada automática a browser stealth ante 2 decoys consecutivos.
# Requiere `scrapling install` (descarga Chromium ~300MB). Sin él, el
# fallback se desactiva en runtime y solo opera HTTP+warming.
SCRAPER_STEALTH_FALLBACK=1
